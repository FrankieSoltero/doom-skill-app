# The app's configuration (src/config.ts). Copy this file to apps/mobile/.env, which git ignores.
# Expo puts these values into the bundle when it builds it, so they are public: never put a
# secret here. Restart `expo start` after a change.
#
# `fixture` runs the app on the demo cards and needs nothing else; `api` needs the three below.
EXPO_PUBLIC_DATA_SOURCE=fixture
# The local API server and the local Supabase stack. A device reaches the Mac by its LAN address
# (http://192.168.x.y:8000); plain http works only in a development build and only for a
# loopback or private address. A release build needs https.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Empty here. `supabase status` prints the local stack's anon key; put it in .env only.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
