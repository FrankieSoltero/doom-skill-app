{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/build-strudel.mjs && expo start",
    "lint": "node scripts/build-strudel.mjs && eslint . --max-warnings 0",
    "typecheck": "node scripts/build-strudel.mjs && tsc --noEmit",
    "test": "jest --ci --coverage && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/__tests__/*.test.mjs",
    "build:strudel": "node scripts/build-strudel.mjs",
    "gen:types": "openapi-typescript ../../services/api/openapi.json -o src/api/schema.d.ts",
    "postinstall": "node scripts/build-strudel.mjs --postinstall"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "lucide-react-native": "1.48.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@strudel/web": "1.3.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
